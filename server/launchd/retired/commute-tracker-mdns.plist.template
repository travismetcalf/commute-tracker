<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/dns-sd</string>
    <string>-P</string>
    <string>Commute Tracker</string>
    <string>_http._tcp</string>
    <string>local</string>
    <string>80</string>
    <string>__MDNS_HOSTNAME__</string>
    <string>__MDNS_IP__</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/commute-tracker-mdns.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/commute-tracker-mdns.log</string>
</dict>
</plist>
