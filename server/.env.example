# TomTom API key — ONE key covers all three products this app uses; make sure
# the key has these enabled (Key Management -> select key -> check products):
#   Routing API (20K/mo free) · Map Display API (Maps Raster) (20K/mo)
#   Traffic Flow & Incidents API Raster Tiles (200K/mo)
# Register at my.tomtom.com (developer.tomtom.com retires 2026-09-15).
# Free tier, no credit card; overage = 429s, never a bill.
# Store it in your password manager.
TOMTOM_API_KEY=

# Bearer token for the /api/v1/* surface (iOS app, widget).
# Auto-generated by scripts/install.sh if blank (secrets.token_urlsafe(32)).
# Store it in your password manager alongside the TomTom key.
API_BEARER_TOKEN=

# APNs push (optional — everything no-ops until these are set).
# Create the key at developer.apple.com -> Certificates, Identifiers &
# Profiles -> Keys -> "+" -> enable Apple Push Notifications service.
# Download the .p8 ONCE (Apple never re-issues it), store it in your password manager,
# and place a copy at data/apns.p8 (gitignored — NEVER commit a .p8).
# APNS_KEY_PATH here is the HOST path, used by the host scripts. The container
# does not read this value: docker-compose.yml hardcodes /app/data/apns.p8,
# which is the same file through the ./data bind mount.
# APNS_KEY_ID is the 10-char id shown next to the key; APNS_TEAM_ID is your
# Apple Developer Team ID; APNS_BUNDLE_ID must match the iOS app target's
# bundle identifier (see ios/project.yml).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# launchd (macOS scheduling — see scripts/install.sh).
# Reverse-DNS prefix for agent labels (e.g. com.yourname). Default: local
LAUNCHD_LABEL_PREFIX=
# Optional LAN mDNS advertisement (dns-sd): hostname + this machine's LAN IP.
# Leave blank to skip the mdns agent entirely.
MDNS_HOSTNAME=
MDNS_IP=

# Notifications (optional — alerts no-op when nothing is configured).
# NOTIFY_CMD: any command that accepts --subject <s> --text-file <path>.
# NOTIFY_ENV_FILE: env file handed to the notifier for its credentials.
NOTIFY_CMD=
NOTIFY_ENV_FILE=
